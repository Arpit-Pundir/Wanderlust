<% layout("/listings/layout/boilerplate") -%>

<div class="row mt-3">

    <div class="col-8 offset-2">

        <h3>Create a New Listing</h3>

        <form
            method="POST"
            action="/listings"
            enctype="multipart/form-data"
            class="needs-validation"
            novalidate
        >

            <!-- TITLE -->
            <div class="mb-3">

                <label
                    for="title"
                    class="form-label"
                >
                    Title
                </label>

                <input
                    name="listing[title]"
                    id="title"
                    type="text"
                    class="form-control"
                    placeholder="Enter title"
                    required
                >

                <div class="valid-feedback">
                    Title looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter a title.
                </div>

            </div>

            <!-- DESCRIPTION -->
            <div class="mb-3">

                <label
                    for="description"
                    class="form-label"
                >
                    Description
                </label>

                <textarea
                    name="listing[description]"
                    id="description"
                    class="form-control"
                    rows="3"
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please enter a description.
                </div>

            </div>

            <!-- IMAGE UPLOAD -->
            <div class="mb-3">

                <label
                    for="image"
                    class="form-label"
                >
                    Upload Image
                </label>

                <input
                    name="listing[image]"
                    id="image"
                    type="file"
                    class="form-control"
                >

            </div>

            <!-- PRICE -->
            <div class="mb-3">

                <label
                    for="price"
                    class="form-label"
                >
                    Price
                </label>

                <input
                    name="listing[price]"
                    id="price"
                    type="number"
                    class="form-control"
                    placeholder="1200"
                    min="0"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a valid price.
                </div>

            </div>

            <div class="row">

                <!-- LOCATION -->
                <div class="mb-3 col-md-8">

                    <label
                        for="location"
                        class="form-label"
                    >
                        Location
                    </label>

                    <input
                        name="listing[location]"
                        id="location"
                        type="text"
                        class="form-control"
                        placeholder="Manali"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a location.
                    </div>

                </div>

                <!-- COUNTRY -->
                <div class="mb-3 col-md-4">

                    <label
                        for="country"
                        class="form-label"
                    >
                        Country
                    </label>

                    <input
                        name="listing[country]"
                        id="country"
                        type="text"
                        class="form-control"
                        placeholder="India"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a country.
                    </div>

                </div>

            </div>

            <button class="btn btn-dark add-btn">
                Add
            </button>

        </form>

    </div>

</div>