<% layout("/listings/layout/boilerplate") -%>

<div class="row mt-3">

    <!-- TITLE -->
    <div class="col-8 offset-2">
        <h3>
            <%= listing.title %>
        </h3>
    </div>

    <!-- LISTING CARD -->
    <div class="card col-6 offset-2 show-card">

        <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing_image"
        >

        <div class="card-body">

            <p class="card-text">

                <%= listing.description %>

                <br><br>

                ₹ <%= listing.price.toLocaleString("en-IN") %>
                / night

                <br>

                <%= listing.location %>,
                <%= listing.country %>

                <br><br>

                <% if (listing.owner) { %>
                    <b>Owner:</b>
                    <%= listing.owner.username %>
                <% } %>

            </p>

        </div>

    </div>

    <!-- EDIT + DELETE -->
    <div class="btns mt-3">

        <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-dark col-1 offset-2"
        >
            Edit
        </a>

        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
        >
            <button class="btn btn-dark offset-4">
                Delete
            </button>
        </form>

    </div>

    <!-- LEAVE REVIEW -->
    <div class="col-8 offset-2 mt-4">

        <hr>

        <h4>
            Leave a Review
        </h4>

        <form
            action="/listings/<%= listing._id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation"
        >

            <div class="mb-3 mt-3">

                <fieldset class="starability-slot">

                    <legend>
                        Rating:
                    </legend>

                    <input
                        type="radio"
                        id="rating-5"
                        name="review[rating]"
                        value="5"
                        required
                    >
                    <label for="rating-5" title="Amazing">
                        5 stars
                    </label>

                    <input
                        type="radio"
                        id="rating-4"
                        name="review[rating]"
                        value="4"
                    >
                    <label for="rating-4" title="Very Good">
                        4 stars
                    </label>

                    <input
                        type="radio"
                        id="rating-3"
                        name="review[rating]"
                        value="3"
                    >
                    <label for="rating-3" title="Average">
                        3 stars
                    </label>

                    <input
                        type="radio"
                        id="rating-2"
                        name="review[rating]"
                        value="2"
                    >
                    <label for="rating-2" title="Bad">
                        2 stars
                    </label>

                    <input
                        type="radio"
                        id="rating-1"
                        name="review[rating]"
                        value="1"
                    >
                    <label for="rating-1" title="Terrible">
                        1 star
                    </label>

                </fieldset>

                <p
                    id="rating-text"
                    class="mt-2 mb-0"
                >
                    Select a rating
                </p>

            </div>

            <div class="mb-3">

                <label
                    for="comment"
                    class="form-label"
                >
                    Comment
                </label>

                <textarea
                    name="review[comment]"
                    id="comment"
                    rows="4"
                    class="form-control"
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please enter a comment.
                </div>

            </div>

            <button
                type="submit"
                class="btn btn-outline-dark"
            >
                Submit
            </button>

        </form>

    </div>

    <!-- ALL REVIEWS -->
    <div class="col-8 offset-2 mt-4">

        <hr>

        <h4>
            All Reviews
        </h4>

        <div class="row">

            <% if (listing.reviews.length > 0) { %>

                <% for (let review of listing.reviews) { %>

                    <div class="card col-5 ms-3 mb-3 review-card">

                        <div class="card-body">

                            <h5 class="card-title">
                                <%= review.author
                                    ? review.author.username
                                    : "Anonymous"
                                %>
                            </h5>

                            <p class="card-text">
                                <%= review.comment %>
                            </p>

                            <p
                                class="starability-result"
                                data-rating="<%= review.rating %>"
                            >
                                Rated:
                                <%= review.rating %>
                                stars
                            </p>

                            <form
                                method="POST"
                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                            >
                                <button class="btn btn-sm btn-dark">
                                    Delete
                                </button>
                            </form>

                        </div>

                    </div>

                <% } %>

            <% } else { %>

                <p>
                    No reviews yet.
                </p>

            <% } %>

        </div>

    </div>

    <!-- MAP -->
    <div class="col-8 offset-2 mt-4">

        <hr>

        <h3>
            Where you'll be
        </h3>

        <% if (listing.geometry && listing.geometry.coordinates) { %>

            <div
                id="map"
                data-token="<%= mapToken %>"
                data-coordinates='<%- JSON.stringify(listing.geometry.coordinates) %>'
                data-title="<%= listing.title %>"
            ></div>

        <% } else { %>

            <p>
                Location coordinates are not available for this listing.
            </p>

        <% } %>

    </div>

</div>

<!-- RATING SCRIPT -->
<script>

    const ratingInputs =
        document.querySelectorAll(
            'input[name="review[rating]"]'
        );

    const ratingText =
        document.getElementById(
            "rating-text"
        );

    const ratingNames = {
        1: "Terrible",
        2: "Bad",
        3: "Average",
        4: "Very Good",
        5: "Amazing"
    };

    ratingInputs.forEach((rating) => {

        rating.addEventListener(
            "change",
            () => {

                const value =
                    Number(rating.value);

                ratingText.innerText =
                    `${value} Star${value === 1 ? "" : "s"} — ${ratingNames[value]}`;

            }
        );

    });

</script>

<!-- MAPBOX SCRIPT -->
<script>

    const mapElement =
        document.getElementById("map");

    if (mapElement) {

        const token =
            mapElement.dataset.token;

        const coordinates =
            JSON.parse(
                mapElement.dataset.coordinates
            );

        const listingTitle =
            mapElement.dataset.title;

        mapboxgl.accessToken =
            token;

        const map =
            new mapboxgl.Map({
                container: "map",
                center: coordinates,
                zoom: 9
            });

        const popup =
            new mapboxgl.Popup({
                offset: 25
            })
            .setHTML(
                `<h6>${listingTitle}</h6>
                 <p>Exact location will be provided after booking</p>`
            );

        const marker =
            new mapboxgl.Marker()
                .setLngLat(coordinates)
                .setPopup(popup)
                .addTo(map);

    }

</script>